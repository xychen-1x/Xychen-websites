---
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import { assets } from "@config/assets";
import "@styles/global.css";
import "@styles/refined.css";

interface Props {
  title?: string;
  description?: string;
  sectionTheme?: "default" | "garden";
}

const {
  title = "XYCHEN",
  description = "Gaming, community, and creator projects from XYCHEN.",
  sectionTheme = "default",
} = Astro.props;

const pageTitle = title.toUpperCase() === "XYCHEN" ? "XYCHEN" : `${title} | XYCHEN`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const isGardenSection = sectionTheme === "garden";
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#EAF0DF" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href={assets.favicon} />
    <title>{pageTitle}</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="XYCHEN" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body class:list={["site-shell", isGardenSection && "site-shell--garden"]}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <script>
      import "../scripts/theme";
    </script>
  </body>
</html>
