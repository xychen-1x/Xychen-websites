---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import ContentCard from "@components/ContentCard.astro";
import { contentCategories } from "@config/content";

const articles = (await getCollection("articles"))
  .filter((article) => article.data.publicationStatus === "published")
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<BaseLayout title="Gaming" description="Browse published game guides, tips, discoveries, and updates from Xychen.">
  <section class="page-hero content-library-hero">
    <div class="container">
      <p class="eyebrow">Gaming library</p>
      <h1>Explore the <span>game library.</span></h1>
      <p class="page-lead">Browse published guides, discoveries, and game updates.</p>
    </div>
  </section>

  <section class="section-block gaming-category-section">
    <div class="container">
      <div class="section-heading">
        <div><p class="eyebrow">Browse by topic</p><h2>Categories</h2></div>
        <p class="section-intro">Choose a topic to see its published articles.</p>
      </div>
      <div class="content-category-grid">
        {contentCategories.map((category) => (
          <a class="content-category-card gaming-image-card" href={`/content/category/${category.slug}/`}>
            <h2>{category.label}</h2>
            <p>{category.description}</p>
            <span class="content-category-count">Browse <span aria-hidden="true">↗</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section-block content-latest-section">
    <div class="container">
      <div class="section-heading">
        <div><p class="eyebrow">Published library</p><h2>Gaming content</h2></div>
      </div>
      <div class="content-search">
        <label for="content-search">Search published content</label>
        <input id="content-search" type="search" placeholder="Search guides, seeds, mechanics, updates…" autocomplete="off">
        <p class="content-search-status" aria-live="polite">Showing published articles</p>
      </div>
      {articles.length > 0 ? (
        <div class="content-grid" data-search-grid>
          {articles.map((article) => <ContentCard article={article} />)}
        </div>
      ) : (
        <div class="content-empty-state"><h2>No published articles yet.</h2><p>Articles will appear here after they are ready for publication.</p></div>
      )}
      <p class="content-search-empty" data-search-empty hidden>No matching published articles. Try another search.</p>
    </div>
  </section>

  <script>
    const input = document.querySelector<HTMLInputElement>("#content-search");
    const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-search-grid] .content-card"));
    const status = document.querySelector<HTMLElement>(".content-search-status");
    const empty = document.querySelector<HTMLElement>("[data-search-empty]");
    const initialQuery = new URLSearchParams(window.location.search).get("q")?.trim() ?? "";

    if (input && initialQuery) input.value = initialQuery;

    function filterArticles() {
      const query = input?.value.trim().toLocaleLowerCase() ?? "";
      let visibleCount = 0;

      for (const card of cards) {
        const searchable = card.dataset.searchText ?? card.textContent ?? "";
        const matches = searchable.toLocaleLowerCase().includes(query);
        card.hidden = !matches;
        if (matches) visibleCount += 1;
      }

      if (status) {
        status.textContent = query
          ? `Found ${visibleCount} of ${cards.length} published articles`
          : `Showing all ${cards.length} published articles`;
      }
      if (empty) empty.hidden = visibleCount !== 0;
    }

    input?.addEventListener("input", filterArticles);
    if (initialQuery) filterArticles();
  </script>
</BaseLayout>
