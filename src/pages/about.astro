---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout
  title="About"
  description="About Xychen and the gaming content, community, and creative work shared on this website."
>
  <section class="page-hero about-hero">
    <div class="container about-hero-layout">
      <div class="about-hero-copy">
        <p class="eyebrow">About Xychen</p>
        <h1>Curiosity starts <span>somewhere.</span></h1>
        <p class="page-lead">
          A creator-led space for gaming discoveries, useful guides, and community.
        </p>
      </div>
      <img
        class="about-hero-image"
        src="/assets/backgrounds/80a0a90bba597a7bfc687ccbcc2d2ae0.jpg"
        alt="A glowing cosmic scene with a bright sphere held above an outstretched hand"
        width="1536"
        height="864"
        loading="eager"
        decoding="async"
      />
    </div>
  </section>

  <section class="section-block about-content-section">
    <div class="container narrow-content prose about-copy">
      <h2>What to expect</h2>
      <p>Explore Roblox content, including Grow a Garden, alongside guides, tips, discoveries, and game updates. More games and projects may be added as the site grows.</p>

      <h2>Accuracy matters</h2>
      <p>Guides and updates should be clear, dated when relevant, and supported by checkable sources. Rumors and leaks are always labelled unconfirmed.</p>

      <h2>Community</h2>
      <p>Connect with other members through the official XYCHEN Discord community.</p>
      <p><a href="https://discord.com/invite/xychen-server-1417846380432719915" target="_blank" rel="noopener noreferrer">Visit the Discord community</a></p>
    </div>
  </section>
</BaseLayout>
