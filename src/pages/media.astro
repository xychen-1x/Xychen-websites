---
import BaseLayout from "@layouts/BaseLayout.astro";
import "@styles/media.css";

const featuredTikToks = [
  { label: "Featured TikTok 01", href: "https://vt.tiktok.com/ZSsLALB2v/" },
  { label: "Featured TikTok 02", href: "https://vt.tiktok.com/ZSsLSgN91/" },
  { label: "Featured TikTok 03", href: "https://vt.tiktok.com/ZSsLSaqhS/" },
];

const featuredYouTubeShorts = [
  { id: "mJ4sNqUdTQQ", label: "YouTube Short 01" },
  { id: "QLzWryv1i3E", label: "YouTube Short 02" },
  { id: "rmLW6b0upuk", label: "YouTube Short 03" },
];

const platforms = [
  {
    name: "YouTube",
    handle: "@xychenxycz",
    description: "Gameplay videos, Shorts, highlights, and streams.",
    href: "https://www.youtube.com/@xychenxycz",
    action: "Visit YouTube",
    mark: "YT",
    className: "youtube",
    formats: [
      { label: "Videos", href: "https://www.youtube.com/@xychenxycz/videos" },
      { label: "Shorts", href: "https://www.youtube.com/@xychenxycz/shorts" },
      { label: "Streams", href: "https://www.youtube.com/@xychenxycz/streams" },
    ],
  },
  {
    name: "TikTok",
    handle: "@x1ychen",
    description: "Short-form gameplay, clips, and quick updates.",
    href: "https://www.tiktok.com/@x1ychen",
    action: "Visit TikTok",
    mark: "♪",
    className: "tiktok",
    formats: [],
  },
];
---

<BaseLayout
  title="Media"
  description="Watch Xychen's own TikTok and YouTube videos, clips, Shorts, and livestreams."
>
  <section class="media-hero page-hero">
    <div class="container media-hero-inner">
      <p class="eyebrow">Xychen · Creator media</p>
      <h1>Videos, clips, <span>and moments.</span></h1>
      <p class="page-lead">
        One place for my uploads on TikTok and YouTube. Browse each platform or explore selected videos as this collection grows.
      </p>
      <div class="media-hero-actions">
        <a class="button button-primary" href="#platforms">Explore platforms <span aria-hidden="true">↓</span></a>
        <a class="button media-hero-secondary" href="/links/">All links <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="section-block media-platform-section" id="platforms" aria-labelledby="platforms-title">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">My channels</p>
          <h2 id="platforms-title">Find me on</h2>
        </div>
        <p class="section-intro">Only content published on my own accounts is included here.</p>
      </div>

      <div class="media-platform-grid">
        {platforms.map((platform) => (
          <article class:list={["media-platform-card", `media-platform-card--${platform.className}`]}>
            <div class="media-platform-top">
              <span class="media-platform-mark" aria-hidden="true">{platform.mark}</span>
              <span class="media-platform-label">{platform.name}</span>
            </div>
            <p class="media-platform-handle">{platform.handle}</p>
            <p class="media-platform-description">{platform.description}</p>
            {platform.formats.length > 0 && (
              <nav class="media-format-links" aria-label={`Browse ${platform.name} formats`}>
                {platform.formats.map((format) => (
                  <a href={format.href} target="_blank" rel="noopener noreferrer">{format.label}<span aria-hidden="true">↗</span></a>
                ))}
              </nav>
            )}
            <a class="media-platform-action" href={platform.href} target="_blank" rel="noopener noreferrer">
              {platform.action} <span aria-hidden="true">↗</span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-block media-feed-section" aria-labelledby="trending-title">
    <div class="container">
      <div class="section-heading media-feed-heading">
        <div>
          <p class="eyebrow">Picked from my uploads</p>
          <h2 id="trending-title">Featured & trending</h2>
        </div>
        <p class="section-intro">A shortlist of my videos. Popularity labels and view counts will only appear when verified platform data is available.</p>
      </div>
      <div class="media-featured-grid">
        {featuredTikToks.map((video) => (
          <article class="media-featured-card">
            <div class="media-featured-art" aria-hidden="true">
              <span>♪</span>
              <small>TIKTOK</small>
            </div>
            <div class="media-featured-content">
              <p class="media-featured-platform">My TikTok upload</p>
              <h3>{video.label}</h3>
              <a href={video.href} target="_blank" rel="noopener noreferrer" aria-label={`Watch ${video.label} on TikTok`}>
                Watch on TikTok <span aria-hidden="true">↗</span>
              </a>
            </div>
          </article>
        ))}
      </div>
      <div class="media-youtube-shorts">
        <div class="media-subheading">
          <div>
            <p class="eyebrow">YouTube</p>
            <h3>Selected Shorts</h3>
          </div>
          <a href="https://www.youtube.com/@xychenxycz/shorts" target="_blank" rel="noopener noreferrer">View all Shorts <span aria-hidden="true">↗</span></a>
        </div>
        <div class="media-shorts-grid">
          {featuredYouTubeShorts.map((video) => (
            <article class="media-short-card">
              <div class="media-short-embed">
                <iframe
                  src={`https://www.youtube-nocookie.com/embed/${video.id}`}
                  title={video.label}
                  loading="lazy"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                  referrerpolicy="strict-origin-when-cross-origin"
                  allowfullscreen
                ></iframe>
              </div>
              <div class="media-short-caption">
                <strong>{video.label}</strong>
                <a href={`https://youtube.com/shorts/${video.id}`} target="_blank" rel="noopener noreferrer">Open on YouTube <span aria-hidden="true">↗</span></a>
              </div>
            </article>
          ))}
        </div>
      </div>
      <p class="media-featured-note">The YouTube Shorts above are embedded from the links provided. TikTok posts currently link directly to TikTok; their thumbnails, embedded playback, and verified view counts are not available in this page yet.</p>
    </div>
  </section>

  <section class="section-block media-latest-section" aria-labelledby="latest-title">
    <div class="container">
      <div class="section-heading media-feed-heading">
        <div>
          <p class="eyebrow">YouTube channel</p>
          <h2 id="latest-title">Latest uploads</h2>
        </div>
        <p class="section-intro">Recent public uploads from @xychenxycz, refreshed once a day. View counts are snapshots from the last successful sync.</p>
      </div>
      <div class="media-latest-panel" id="youtube-latest" data-feed-url="/api/media">
        <div class="media-latest-status" role="status" aria-live="polite">
          <span class="media-sync-indicator" aria-hidden="true"></span>
          <strong>Waiting for the first YouTube sync</strong>
        </div>
        <p class="media-latest-message">The YouTube connection will appear here after its API key and private storage are configured.</p>
        <p class="media-sync-time" id="youtube-sync-time"></p>
        <div class="media-latest-grid" id="youtube-latest-grid"></div>
      </div>
    </div>
  </section>

  <script>
    type FeedItem = {
      id: string;
      title: string;
      publishedAt: string;
      thumbnailUrl: string | null;
      url: string;
      viewCount: number | null;
    };

    type FeedResponse = {
      status: "ready" | "not-configured" | "pending-first-sync" | "unavailable";
      lastSyncedAt: string | null;
      items: FeedItem[];
    };

    const panel = document.querySelector<HTMLElement>("#youtube-latest");
    const status = panel?.querySelector<HTMLElement>(".media-latest-status");
    const message = panel?.querySelector<HTMLElement>(".media-latest-message");
    const syncTime = panel?.querySelector<HTMLElement>("#youtube-sync-time");
    const grid = panel?.querySelector<HTMLElement>("#youtube-latest-grid");

    const setStatus = (heading: string, detail: string) => {
      if (status) {
        const strong = document.createElement("strong");
        strong.textContent = heading;
        status.replaceChildren(strong);
      }
      if (message) message.textContent = detail;
    };

    const formatDate = (value: string) => {
      const date = new Date(value);
      return Number.isNaN(date.getTime())
        ? "Date unavailable"
        : new Intl.DateTimeFormat(undefined, { dateStyle: "medium" }).format(date);
    };

    const renderFeed = (items: FeedItem[]) => {
      if (!grid) return;
      grid.replaceChildren();

      for (const item of items) {
        const article = document.createElement("article");
        article.className = "media-latest-card";

        const link = document.createElement("a");
        link.className = "media-latest-thumb";
        link.href = item.url;
        link.target = "_blank";
        link.rel = "noopener noreferrer";
        link.setAttribute("aria-label", `Watch ${item.title} on YouTube`);

        if (item.thumbnailUrl) {
          const image = document.createElement("img");
          image.src = item.thumbnailUrl;
          image.alt = "";
          image.loading = "lazy";
          image.width = 480;
          image.height = 360;
          link.append(image);
        } else {
          const fallback = document.createElement("span");
          fallback.textContent = "YouTube";
          link.append(fallback);
        }

        const title = document.createElement("h3");
        const titleLink = document.createElement("a");
        titleLink.href = item.url;
        titleLink.target = "_blank";
        titleLink.rel = "noopener noreferrer";
        titleLink.textContent = item.title;
        title.append(titleLink);

        const meta = document.createElement("p");
        meta.className = "media-latest-meta";
        const viewLabel = item.viewCount === null
          ? "Views unavailable"
          : `${new Intl.NumberFormat().format(item.viewCount)} views at last sync`;
        meta.textContent = `${formatDate(item.publishedAt)} · ${viewLabel}`;

        article.append(link, title, meta);
        grid.append(article);
      }
    };

    const loadYouTubeFeed = async () => {
      if (!panel || !status || !message || !grid) return;

      try {
        const response = await fetch(panel.dataset.feedUrl ?? "/api/media", {
          headers: { Accept: "application/json" },
        });
        if (!response.ok) throw new Error("Feed request failed");

        const feed = (await response.json()) as FeedResponse;

        if (feed.status === "not-configured") {
          setStatus(
            "YouTube sync is not configured yet",
            "The API key and private storage still need to be connected in Vercel.",
          );
          return;
        }

        if (feed.status === "pending-first-sync") {
          setStatus(
            "Waiting for the first YouTube sync",
            "The connection is configured, but the first daily snapshot has not been saved yet.",
          );
          return;
        }

        if (feed.status !== "ready") {
          setStatus(
            "Latest uploads are temporarily unavailable",
            "The saved feed could not be loaded. The selected Shorts above are still available.",
          );
          return;
        }

        if (feed.lastSyncedAt && syncTime) {
          syncTime.textContent = `Last successful sync: ${formatDate(feed.lastSyncedAt)}. Counts are not live.`;
        }

        if (!feed.items.length) {
          setStatus(
            "No public uploads were returned",
            "The YouTube API did not return public uploads for this channel at the last sync.",
          );
          return;
        }

        setStatus("Latest uploads from YouTube", `${feed.items.length} recent public uploads.`);
        renderFeed(feed.items);
      } catch {
        setStatus(
          "Latest uploads could not be loaded",
          "Please try again later. The selected Shorts above remain available.",
        );
      }
    };

    void loadYouTubeFeed();
  </script>

  <style>
    .media-hero-actions { display:flex; flex-wrap:wrap; gap:12px; margin-top:28px; }
    .media-hero-secondary { border-color:rgb(255 255 255 / 45%); background:rgb(255 255 255 / 12%); color:#fff; }
    .media-platform-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:18px; }
    .media-platform-card { min-width:0; display:flex; flex-direction:column; align-items:flex-start; padding:clamp(22px,3vw,32px); border:1px solid var(--line); border-radius:var(--radius-card); background:color-mix(in srgb,var(--surface) 84%,transparent); box-shadow:var(--shadow-soft); }
    .media-platform-top { display:flex; align-items:center; gap:12px; }
    .media-platform-mark { width:44px; height:44px; display:grid; place-items:center; border-radius:13px; background:var(--accent-soft); color:var(--accent); font-size:1.25rem; font-weight:900; }
    .media-platform-label { font-size:1.05rem; font-weight:850; }
    .media-platform-handle { margin:24px 0 4px; font-size:clamp(1.6rem,3vw,2.2rem); font-weight:850; letter-spacing:-.055em; }
    .media-platform-description { margin:0; color:var(--muted); }
    .media-format-links { display:flex; flex-wrap:wrap; gap:8px; margin-top:20px; }
    .media-format-links a { display:inline-flex; gap:8px; padding:7px 11px; border:1px solid var(--line); border-radius:999px; color:var(--muted); font-size:.8rem; font-weight:700; }
    .media-format-links a:hover { border-color:var(--accent); color:var(--accent); }
    .media-platform-action { display:inline-flex; gap:10px; align-items:center; margin-top:auto; padding-top:26px; color:var(--accent); font-weight:800; }
    .media-platform-card--tiktok .media-platform-mark { background:#202020; color:#fff; }
    .media-feed-section { padding-top:34px; }
    .media-latest-panel { padding:clamp(22px,4vw,34px); border:1px solid var(--line); border-radius:var(--radius-card); background:color-mix(in srgb,var(--surface) 82%,transparent); }
    .media-featured-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:16px; }
    .media-featured-card { min-width:0; overflow:hidden; border:1px solid var(--line); border-radius:var(--radius-card); background:var(--surface); box-shadow:var(--shadow-soft); }
    .media-featured-art { min-height:150px; display:flex; align-items:center; justify-content:center; position:relative; background:linear-gradient(135deg,#18251d,#435d42); color:#fff; }
    .media-featured-art > span { font-size:3rem; font-weight:900; }
    .media-featured-art small { position:absolute; right:14px; bottom:12px; font-size:.68rem; font-weight:850; letter-spacing:.14em; }
    .media-featured-content { padding:18px; }
    .media-featured-platform { margin:0 0 6px; color:var(--muted); font-size:.75rem; font-weight:750; }
    .media-featured-content h3 { margin:0; font-size:1.08rem; }
    .media-featured-content a { display:inline-flex; gap:8px; margin-top:16px; color:var(--accent); font-size:.86rem; font-weight:800; }
    .media-featured-note { margin:14px 0 0; color:var(--muted); font-size:.84rem; }
    .media-youtube-shorts { margin-top:34px; }
    .media-subheading { display:flex; align-items:end; justify-content:space-between; gap:16px; margin-bottom:16px; }
    .media-subheading .eyebrow { margin:0 0 5px; }
    .media-subheading h3 { margin:0; font-size:1.35rem; letter-spacing:-.035em; }
    .media-subheading > a,.media-short-caption a { color:var(--accent); font-size:.82rem; font-weight:800; }
    .media-shorts-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:16px; }
    .media-short-card { min-width:0; overflow:hidden; border:1px solid var(--line); border-radius:var(--radius-card); background:var(--surface); box-shadow:var(--shadow-soft); }
    .media-short-embed { width:100%; aspect-ratio:9/16; background:#111; }
    .media-short-embed iframe { display:block; width:100%; height:100%; border:0; }
    .media-short-caption { display:flex; flex-direction:column; gap:8px; padding:14px; }
    .media-short-caption strong { font-size:.9rem; }
    .media-short-caption a { color:var(--accent); font-size:.82rem; font-weight:800; }
    .media-featured-note { margin:14px 0 0; color:var(--muted); font-size:.84rem; }
    .media-latest-section { padding-top:12px; }
    .media-latest-status { display:flex; align-items:center; gap:11px; }
    .media-sync-indicator { width:9px; height:9px; flex:0 0 9px; border-radius:50%; background:var(--muted); }
    .media-latest-message,.media-sync-time { margin:8px 0 0; color:var(--muted); }
    .media-sync-time { font-size:.8rem; }
    .media-latest-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:16px; margin-top:22px; }
    .media-latest-card { min-width:0; overflow:hidden; border:1px solid var(--line); border-radius:var(--radius-card); background:var(--surface); }
    .media-latest-thumb { display:block; aspect-ratio:16/9; overflow:hidden; background:var(--accent-soft); }
    .media-latest-thumb img { display:block; width:100%; height:100%; object-fit:cover; }
    .media-latest-thumb > span { display:grid; width:100%; height:100%; place-items:center; color:var(--muted); font-weight:800; }
    .media-latest-card h3 { margin:14px 14px 0; font-size:.98rem; line-height:1.4; }
    .media-latest-card h3 a { color:inherit; }
    .media-latest-meta { margin:8px 14px 14px; color:var(--muted); font-size:.78rem; line-height:1.5; }
    @media (max-width:760px) {
      .media-platform-grid,.media-featured-grid,.media-shorts-grid,.media-latest-grid { grid-template-columns:1fr; }
      .media-short-card,.media-latest-card { max-width:340px; margin-inline:auto; width:100%; }
      .media-subheading { align-items:flex-start; flex-direction:column; }
      .media-hero-actions { align-items:stretch; flex-direction:column; max-width:290px; }
    }
    @media (prefers-reduced-motion:reduce) { .media-platform-card { transition:none; } }
    :root[data-theme="dark"] .media-platform-card,:root[data-theme="dark"] .media-latest-panel { background:color-mix(in srgb,var(--surface) 86%,transparent); }
  </style>
</BaseLayout>
