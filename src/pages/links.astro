---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout
  title="Links"
  description="Official project and website links for Xychen."
>
  <section class="page-hero">
    <div class="container narrow-content">
      <p class="eyebrow">Links</p>
      <h1>Find Xychen <span>elsewhere.</span></h1>
      <p class="page-lead">Official profile links will be listed here after they are confirmed for this version of the website.</p>
    </div>
  </section>
  <section class="section-block">
    <div class="container narrow-content">
      <a class="external-link-row" href="https://github.com/xychen-1x/Xychen-websites" target="_blank" rel="noopener noreferrer">
        <span><strong>Website source code</strong><small>GitHub repository</small></span>
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</BaseLayout>
