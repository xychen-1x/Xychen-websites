---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout
  title="Games"
  description="Explore game coverage planned for the Xychen website."
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Game directory</p>
      <h1>More games.<br /><span>More to explore.</span></h1>
      <p class="page-lead">A growing directory for game-specific guides, information, and coverage.</p>
    </div>
  </section>
  <section class="section-block">
    <div class="container">
      <a class="feature-card game-card" href="/grow-a-garden/">
        <span class="card-index">ROBLOX · FEATURED CATEGORY</span>
        <h2>Grow a Garden</h2>
        <p>Open the dedicated section for this game.</p>
        <span class="card-arrow" aria-hidden="true">↗</span>
      </a>
      <p class="notice">Additional game sections will be added when their content is ready.</p>
    </div>
  </section>
</BaseLayout>
