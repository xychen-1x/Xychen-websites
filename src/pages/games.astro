---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout
  title="Games"
  description="Explore game coverage planned for the Xychen website."
>
  <section class="page-hero games-page-hero">
    <div class="container">
      <p class="eyebrow">Game directory · 1 available section</p>
      <h1>Games we <span>cover.</span></h1>
      <p class="page-lead">
        Game-specific guides, information, discoveries, and updates are organized
        into dedicated sections as coverage becomes available.
      </p>
    </div>
  </section>

  <section class="section-block">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Available now</p>
          <h2>Game sections</h2>
        </div>
        <p class="section-intro">
          Each section links to its own published information. More games will
          appear when there is useful, reviewed content to support them.
        </p>
      </div>

      <a class="feature-card game-card game-directory-card" href="/grow-a-garden/">
        <span class="card-index">ROBLOX · GAME SECTION</span>
        <h2>Grow a Garden</h2>
        <p>Browse the current beginner guide and future game-specific coverage.</p>
        <span class="card-arrow" aria-hidden="true">Explore game ↗</span>
      </a>

      <p class="notice">Additional game sections will be added when their content is ready. No unverified game artwork or placeholder listings are shown.</p>
    </div>
  </section>
</BaseLayout>
