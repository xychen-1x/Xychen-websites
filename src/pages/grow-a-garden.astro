---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import ContentCard from "@components/ContentCard.astro";

const gardenArticles = (await getCollection("articles"))
  .filter(
    (article) =>
      article.data.publicationStatus === "published" &&
      article.data.game === "Grow a Garden",
  )
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<BaseLayout
  title="Grow a Garden"
  description="The Xychen section for Roblox Grow a Garden guides, tips, game information, and updates."
  sectionTheme="garden"
>
  <section class="page-hero garden-page-hero">
    <div class="container">
      <p class="eyebrow"><span class="status-dot"></span> Roblox game hub</p>
      <h1>Grow a <span>Garden.</span></h1>
      <p class="page-lead">
        A focused place for game guides, useful details, discoveries, and update coverage.
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href="/content/category/guides/">Browse guides <span aria-hidden="true">↗</span></a>
        <a class="button button-secondary" href="/content/category/updates/">Game updates</a>
      </div>
    </div>
  </section>

  <section class="section-block garden-overview">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Explore the game</p>
          <h2>What this section covers.</h2>
        </div>
        <p class="section-intro">
          Game-specific information will be organized by topic, with dates and sources attached where they are relevant.
        </p>
      </div>

      <div class="feature-grid garden-feature-grid">
        <article class="feature-card">
          <span class="card-index">01 / LEARN</span>
          <h3>Guides & mechanics</h3>
          <p>Step-by-step explanations for game systems and common tasks.</p>
        </article>
        <article class="feature-card">
          <span class="card-index">02 / EXPLORE</span>
          <h3>Items & discoveries</h3>
          <p>Useful details, findings, and explanations gathered from reliable sources.</p>
        </article>
        <article class="feature-card">
          <span class="card-index">03 / FOLLOW</span>
          <h3>Updates & events</h3>
          <p>Dated coverage that distinguishes official information from community reports.</p>
        </article>
      </div>

      <div class="garden-status-panel" role="note">
        <span class="garden-status-mark" aria-hidden="true">i</span>
        <div>
          <strong>Content is being prepared.</strong>
          <p>Published guides and game information are shown below. Update coverage and larger reference sections will be added as their sources are checked.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section-block garden-content-section">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Published guides</p>
          <h2>Learn the basics.</h2>
        </div>
        <p class="section-intro">
          Game-specific articles are listed here after their information and sources have been reviewed.
        </p>
      </div>
{gardenArticles.length > 0 ? (
        <div class="content-grid">
          {gardenArticles.map((article) => <ContentCard article={article} />)}
        </div>
      ) : (
        <div class="content-empty-state">
          <h3>No published Grow a Garden articles yet.</h3>
          <p>Reviewed game guides and information will appear here.</p>
        </div>
      )}
      <p class="garden-content-more"><a href="/content/">Browse the full content library ↗</a></p>
    </div>
  </section>
</BaseLayout>
