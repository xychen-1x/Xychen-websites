---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import "@styles/home.css";

const articles = (await getCollection("articles"))
  .filter((article) => article.data.publicationStatus === "published")
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const categoryLabels: Record<string, string> = {
  guides: "Guide",
  tips: "Tips",
  discoveries: "Discovery",
  updates: "Update",
  announcements: "Announcement",
};

const dateFormatter = new Intl.DateTimeFormat("en-PH", {
  day: "numeric",
  month: "short",
  year: "numeric",
});
---

<BaseLayout
  title="XYCHEN"
  description="Gaming, community, and creator projects from Xychen — one place to explore, learn, and connect."
>
  <section class="xy-hero">
    <div class="container xy-hero-inner">
      <div class="xy-hero-copy">
        <p class="xy-eyebrow"><span aria-hidden="true"></span> Gaming · Community · Creator</p>
        <h1>A place to <em>play, connect,</em> and explore.</h1>
        <p class="xy-hero-lead">
          XYCHEN brings gaming content, community spaces, and creator projects together in one organized hub.
        </p>
        <div class="xy-hero-actions">
          <a class="xy-button xy-button-primary" href="/content/">Explore gaming <span aria-hidden="true">↗</span></a>
          <a class="xy-button xy-button-secondary" href="#community">Find the community</a>
        </div>
      </div>

      <div class="xy-hero-art" aria-hidden="true">
        <div class="xy-art-orbit xy-art-orbit-one"></div>
        <div class="xy-art-orbit xy-art-orbit-two"></div>
        <div class="xy-art-core"><span>Y</span></div>
        <div class="xy-art-chip xy-art-chip-top">GAME / DISCOVER</div>
        <div class="xy-art-chip xy-art-chip-bottom">COMMUNITY / CREATE</div>
      </div>
    </div>
    <div class="xy-hero-bottom" aria-hidden="true"><span>01</span><span>Explore what’s inside</span><span>↓</span></div>
  </section>

  <section class="xy-pillars section-block" aria-labelledby="xy-pillars-title">
    <div class="container">
      <div class="xy-section-heading">
        <div>
          <p class="xy-eyebrow">The platform</p>
          <h2 id="xy-pillars-title">Three parts. One place.</h2>
        </div>
        <p>Each section has a clear purpose, from useful game information to the people and projects around it.</p>
      </div>

      <div class="xy-pillar-grid">
        <article class="xy-pillar-card xy-pillar-gaming">
          <div class="xy-pillar-visual xy-visual-gaming" aria-hidden="true">
            <span class="xy-visual-label">01 / PLAY</span>
            <div class="xy-game-shape xy-game-shape-one"></div>
            <div class="xy-game-shape xy-game-shape-two"></div>
            <div class="xy-game-shape xy-game-shape-three"></div>
          </div>
          <div class="xy-pillar-copy">
            <p class="xy-card-kicker">Gaming</p>
            <h3>Learn the game. Find something new.</h3>
            <p>Guides, tips, discoveries, and carefully sourced updates for games Xychen covers — starting with Roblox and Grow a Garden.</p>
            <a class="xy-text-link" href="/content/">Explore gaming <span aria-hidden="true">↗</span></a>
          </div>
        </article>

        <article class="xy-pillar-card xy-pillar-community" id="community">
          <div class="xy-pillar-visual xy-visual-community" aria-hidden="true">
            <span class="xy-visual-label">02 / CONNECT</span>
            <div class="xy-community-orb xy-community-orb-one"></div>
            <div class="xy-community-orb xy-community-orb-two"></div>
            <div class="xy-community-orb xy-community-orb-three"></div>
            <div class="xy-community-center">✳</div>
          </div>
          <div class="xy-pillar-copy">
            <p class="xy-card-kicker">Community</p>
            <h3>Continue the conversation.</h3>
            <p>The Discord server is the place for community interaction and conversation beyond the content published on this website.</p>
            <a class="xy-text-link" href="https://discord.com/invite/xychen-server-1417846380432719915" target="_blank" rel="noopener noreferrer">Visit Discord <span aria-hidden="true">↗</span></a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="xy-latest section-block" aria-labelledby="xy-latest-title">
    <div class="container">
      <div class="xy-section-heading">
        <div>
          <p class="xy-eyebrow">Recently published</p>
          <h2 id="xy-latest-title">Latest from XYCHEN.</h2>
        </div>
        <a class="xy-text-link" href="/content/">All gaming content <span aria-hidden="true">↗</span></a>
      </div>

      {articles.length > 0 ? (
        <div class="xy-latest-grid">
          {articles.map((article) => (
            <article class="xy-article-card">
              <div class="xy-article-topline">
                <span>{categoryLabels[article.data.category] ?? "Article"}</span>
                <time datetime={article.data.pubDate.toISOString()}>{dateFormatter.format(article.data.pubDate)}</time>
              </div>
              <p class="xy-article-game">{article.data.game ?? "Gaming"}</p>
              <h3><a href={`/content/${article.id}/`}>{article.data.title}</a></h3>
              <p class="xy-article-description">{article.data.description}</p>
              <a class="xy-article-read" href={`/content/${article.id}/`}>Read article <span aria-hidden="true">↗</span></a>
            </article>
          ))}
        </div>
      ) : (
        <div class="xy-empty-state">
          <h3>New gaming content is being prepared.</h3>
          <p>Published guides and discoveries will appear here when they are ready.</p>
        </div>
      )}
    </div>
  </section>

  <section class="xy-creator-section section-block" aria-labelledby="xy-creator-title">
    <div class="container xy-creator-inner">
      <div>
        <p class="xy-eyebrow">Behind XYCHEN</p>
        <h2 id="xy-creator-title">Made and curated by Xychen.</h2>
        <p>Learn more about the creator, explore current projects, and find official social links.</p>
      </div>
      <div class="xy-creator-actions">
        <a class="xy-button xy-button-secondary" href="/about/">About Xychen</a>
        <a class="xy-text-link" href="/links/">Social links <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
