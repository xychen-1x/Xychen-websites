---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout
  title="Xychen"
  description="Explore Roblox game coverage, practical guides, discoveries, and updates from Xychen."
>
  <section class="hero-section">
    <div class="container hero-content">
      <p class="eyebrow"><span class="status-dot"></span> Independent creator website</p>
      <h1>Explore games.<br /><span>Understand more.</span></h1>
      <p class="hero-description">
        Guides, useful details, game discoveries, and updates — organized in one place.
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href="/content/">Explore content <span aria-hidden="true">↗</span></a>
        <a class="button button-secondary" href="/about/">About Xychen</a>
      </div>
    </div>
    <div class="hero-mark" aria-hidden="true">X</div>
  </section>

  <section class="section-block">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Browse the website</p>
          <h2>Find what you need.</h2>
        </div>
        <p class="section-intro">A structured home for game information, practical help, and things worth exploring.</p>
      </div>

      <div class="feature-grid">
        <a class="feature-card" href="/content/">
          <span class="card-index">01 / CONTENT</span>
          <h3>Guides & discoveries</h3>
          <p>How-tos, tips, explainers, and researched game information.</p>
          <span class="card-arrow" aria-hidden="true">↗</span>
        </a>
        <a class="feature-card" href="/grow-a-garden/">
          <span class="card-index">02 / ROBLOX</span>
          <h3>Grow a Garden</h3>
          <p>A dedicated place for game details, guides, and update coverage.</p>
          <span class="card-arrow" aria-hidden="true">↗</span>
        </a>
        <a class="feature-card" href="/games/">
          <span class="card-index">03 / GAMES</span>
          <h3>Other games</h3>
          <p>Coverage can expand beyond one game as new interests develop.</p>
          <span class="card-arrow" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>

  <section class="statement-section">
    <div class="container statement-inner">
      <p class="eyebrow">The approach</p>
      <h2>Useful information.<br />Clear sources. No guesswork.</h2>
      <p>Published information should be understandable, dated when relevant, and linked to its source. Rumors and leaks will be clearly marked as unconfirmed.</p>
    </div>
  </section>
</BaseLayout>
