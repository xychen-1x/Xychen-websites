---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import { assets } from "@config/assets";
import { getContentCategoryLabel } from "@config/content";

const publishedArticles = (await getCollection("articles"))
  .filter((article) => article.data.publicationStatus === "published")
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const latestArticle = publishedArticles[0];
const latestDate = latestArticle
  ? new Intl.DateTimeFormat("en-PH", { dateStyle: "medium" }).format(latestArticle.data.pubDate)
  : null;

const verificationLabel = latestArticle
  ? {
      verified: "Source checked",
      unconfirmed: "Unconfirmed",
      editorial: "Original",
    }[latestArticle.data.verificationStatus]
  : null;
---

<BaseLayout
  title="Xychen"
  description="Game guides, useful details, and discoveries from Xychen — starting with Roblox and growing beyond it."
>
  <section class="home-hero">
    <div class="container home-hero-layout">
      <div class="home-hero-copy">
        <p class="eyebrow">The website of Xychen</p>
        <h1>Games I play.<br /><span>Things I share.</span></h1>
        <p class="home-hero-description">
          Guides, discoveries, and useful details from Roblox and other games —
          collected in one place.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="/content/">Browse content <span aria-hidden="true">↗</span></a>
          <a class="button button-secondary" href="/about/">About Xychen</a>
        </div>
      </div>

      <figure class="home-hero-visual">
        <img
          src={assets.heroArtwork}
          alt=""
          width="720"
          height="560"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        <figcaption>ROBLOX · GUIDES · DISCOVERIES</figcaption>
      </figure>
    </div>
  </section>

  <section class="home-explore section-block" aria-labelledby="home-explore-title">
    <div class="container home-explore-layout">
      <div class="home-section-intro">
        <p class="eyebrow">Explore</p>
        <h2 id="home-explore-title">Choose where to start.</h2>
        <p>Browse the library, visit a game section, or see what else is covered.</p>
      </div>

      <nav class="home-explore-list" aria-label="Explore the website">
        <a class="home-explore-row" href="/content/">
          <span class="home-explore-number">01</span>
          <span class="home-explore-copy">
            <strong>Content library</strong>
            <small>Guides, tips, discoveries, and updates.</small>
          </span>
          <span class="home-explore-arrow" aria-hidden="true">↗</span>
        </a>
        <a class="home-explore-row home-explore-row--garden" href="/grow-a-garden/">
          <span class="home-explore-number">02</span>
          <span class="home-explore-copy">
            <strong>Grow a Garden</strong>
            <small>Roblox game guides and information.</small>
          </span>
          <span class="home-explore-arrow" aria-hidden="true">↗</span>
        </a>
        <a class="home-explore-row" href="/games/">
          <span class="home-explore-number">03</span>
          <span class="home-explore-copy">
            <strong>Game directory</strong>
            <small>See the games with dedicated coverage.</small>
          </span>
          <span class="home-explore-arrow" aria-hidden="true">↗</span>
        </a>
      </nav>
    </div>
  </section>

  <section class="home-latest section-block" aria-labelledby="home-latest-title">
    <div class="container">
      <div class="home-section-heading">
        <div>
          <p class="eyebrow">From the library</p>
          <h2 id="home-latest-title">Latest content</h2>
        </div>
        <a class="home-text-link" href="/content/">View all content <span aria-hidden="true">↗</span></a>
      </div>

      {latestArticle ? (
        <article class="home-latest-article">
          <div class="home-latest-meta">
            <span>{getContentCategoryLabel(latestArticle.data.category)}</span>
            <time datetime={latestArticle.data.pubDate.toISOString()}>{latestDate}</time>
            <span>{verificationLabel}</span>
          </div>
          <div class="home-latest-main">
            <div>
              <h3>{latestArticle.data.title}</h3>
              <p>{latestArticle.data.description}</p>
            </div>
            <a class="home-text-link" href={`/content/${latestArticle.id}/`}>
              Read article <span aria-hidden="true">↗</span>
            </a>
          </div>
        </article>
      ) : (
        <p class="home-latest-empty">Published articles will appear here when they are ready.</p>
      )}
    </div>
  </section>

  <section class="home-community" aria-labelledby="home-community-title">
    <div class="container home-community-inner">
      <div>
        <p class="eyebrow">Community</p>
        <h2 id="home-community-title">Continue the conversation.</h2>
        <p>Xychen Community is the Discord space connected to this website.</p>
      </div>
      <a
        class="button button-secondary"
        href="https://discord.com/invite/xychen-server-1417846380432719915"
        target="_blank"
        rel="noopener noreferrer"
      >
        Visit Xychen Community <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero {
    border-bottom: 1px solid var(--line);
    background: var(--page);
  }

  .home-hero-layout {
    min-height: 570px;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(280px, 0.9fr);
    align-items: center;
    gap: clamp(28px, 6vw, 88px);
    padding-block: clamp(72px, 9vw, 112px);
  }

  .home-hero-copy {
    min-width: 0;
  }

  .home-hero-copy h1 {
    max-width: 760px;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(3.3rem, 7.2vw, 6.3rem);
    font-weight: 500;
    line-height: 0.99;
    letter-spacing: -0.075em;
  }

  .home-hero-copy h1 span {
    color: var(--accent);
  }

  .home-hero-description {
    max-width: 520px;
    margin: 26px 0 0;
    color: var(--muted);
    font-size: clamp(1.02rem, 1.8vw, 1.16rem);
    line-height: 1.75;
  }

  .home-hero-visual {
    width: 100%;
    max-width: 470px;
    justify-self: end;
    margin: 0;
  }

  .home-hero-visual img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  .home-hero-visual figcaption {
    margin-top: 12px;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-align: center;
  }

  .home-explore-layout {
    display: grid;
    grid-template-columns: minmax(220px, 0.72fr) minmax(0, 1.28fr);
    gap: clamp(40px, 8vw, 120px);
  }

  .home-section-intro h2,
  .home-section-heading h2,
  .home-community h2 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3.2rem);
    line-height: 1.08;
    letter-spacing: -0.06em;
  }

  .home-section-intro > p:last-child {
    max-width: 330px;
    margin: 18px 0 0;
    color: var(--muted);
    line-height: 1.7;
  }

  .home-explore-list {
    border-top: 1px solid var(--line);
  }

  .home-explore-row {
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr) 24px;
    align-items: center;
    gap: 16px;
    min-height: 94px;
    padding: 17px 4px;
    border-bottom: 1px solid var(--line);
    transition: color 150ms ease, padding 150ms ease;
  }

  .home-explore-row:hover {
    padding-inline: 10px;
    color: var(--accent);
  }

  .home-explore-number {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.76rem;
  }

  .home-explore-copy strong,
  .home-explore-copy small {
    display: block;
  }

  .home-explore-copy strong {
    font-size: 1.08rem;
    font-weight: 700;
  }

  .home-explore-copy small {
    margin-top: 5px;
    color: var(--muted);
    font-size: 0.86rem;
    line-height: 1.5;
  }

  .home-explore-arrow {
    color: var(--accent);
    font-size: 1.1rem;
    text-align: right;
  }

  .home-explore-row--garden .home-explore-number,
  .home-explore-row--garden .home-explore-arrow {
    color: #a9ca68;
  }

  :global(:root[data-theme="light"]) .home-explore-row--garden .home-explore-number,
  :global(:root[data-theme="light"]) .home-explore-row--garden .home-explore-arrow {
    color: #557c28;
  }

  .home-latest {
    border-top: 1px solid var(--line);
    background: var(--surface);
  }

  .home-section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 30px;
  }

  .home-text-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--accent);
    font-size: 0.9rem;
    font-weight: 700;
    text-underline-offset: 4px;
  }

  .home-text-link:hover {
    text-decoration: underline;
  }

  .home-latest-article {
    padding-block: 24px;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .home-latest-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    color: var(--muted);
    font-size: 0.78rem;
  }

  .home-latest-meta span:first-child {
    color: var(--accent);
    font-weight: 700;
  }

  .home-latest-main {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 30px;
    margin-top: 18px;
  }

  .home-latest-main h3 {
    margin: 0;
    font-size: clamp(1.35rem, 2.5vw, 1.9rem);
    letter-spacing: -0.045em;
  }

  .home-latest-main p {
    max-width: 650px;
    margin: 9px 0 0;
    color: var(--muted);
    line-height: 1.65;
  }

  .home-latest-main .home-text-link {
    flex: 0 0 auto;
    margin-bottom: 3px;
  }

  .home-latest-empty {
    margin: 0;
    padding-block: 22px;
    border-top: 1px solid var(--line);
    color: var(--muted);
  }

  .home-community {
    padding-block: 64px;
    border-top: 1px solid var(--line);
  }

  .home-community-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }

  .home-community h2 {
    font-size: clamp(1.8rem, 3.5vw, 2.7rem);
  }

  .home-community-inner > div > p:last-child {
    margin: 12px 0 0;
    color: var(--muted);
  }

  @media (max-width: 760px) {
    .home-hero-layout {
      min-height: 0;
      grid-template-columns: 1fr;
      gap: 34px;
      padding-block: 72px 58px;
    }

    .home-hero-copy h1 {
      font-size: clamp(3.1rem, 13vw, 4.8rem);
    }

    .home-hero-visual {
      max-width: 390px;
      justify-self: center;
    }

    .home-explore-layout {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .home-section-intro > p:last-child {
      max-width: 520px;
    }

    .home-latest-main {
      align-items: flex-start;
      flex-direction: column;
      gap: 18px;
    }

    .home-community-inner {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (max-width: 520px) {
    .home-hero-layout {
      padding-block: 60px 48px;
    }

    .home-hero-description {
      margin-top: 20px;
    }

    .home-section-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 14px;
    }

    .home-explore-row {
      grid-template-columns: 30px minmax(0, 1fr) 20px;
      gap: 12px;
      min-height: 84px;
    }

    .home-community {
      padding-block: 52px;
    }
  }
</style>
