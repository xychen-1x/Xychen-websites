---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import "@styles/home.css";

const articles = (await getCollection("articles"))
  .filter((article) => article.data.publicationStatus === "published")
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

const categoryLabels: Record<string, string> = {
  guides: "Guide",
  tips: "Tips",
  discoveries: "Discovery",
  updates: "Update",
  announcements: "Announcement",
};

const dateFormatter = new Intl.DateTimeFormat("en-PH", {
  day: "numeric",
  month: "short",
  year: "numeric",
});
---

<BaseLayout
  title="XYCHEN"
  description="A welcoming place for gaming, community, and creator projects. Explore, discover, and connect with XYCHEN."
>
  <section class="xy-hero" aria-labelledby="xy-hero-title">
    <div class="xy-hero-landscape" aria-hidden="true">
      <span class="xy-sun"></span>
      <span class="xy-hill xy-hill-back"></span>
      <span class="xy-hill xy-hill-front"></span>
      <span class="xy-cloud xy-cloud-one"></span>
      <span class="xy-cloud xy-cloud-two"></span>
    </div>

    <div class="container xy-hero-inner">
      <p class="xy-hero-eyebrow"><span></span> A place to play, connect, and explore</p>
      <h1 id="xy-hero-title">XYCHEN</h1>
      <p class="xy-hero-lead">
        Gaming discoveries, a welcoming community, and creative projects — all gathered in one place.
      </p>
      <div class="xy-hero-actions">
        <a class="xy-button xy-button-primary" href="/content/">Explore gaming <span aria-hidden="true">↗</span></a>
        <a class="xy-button xy-button-secondary" href="#community">Meet the community</a>
      </div>
      <span class="xy-hero-caption" aria-hidden="true">YOUR LITTLE CORNER OF THE INTERNET</span>
    </div>
  </section>

  <section class="xy-pillar-section" aria-label="Explore XYCHEN">
    <div class="container xy-pillar-grid">
      <a class="xy-pillar-card xy-pillar-gaming" href="/content/">
        <div class="xy-pillar-art xy-pillar-art-gaming" aria-hidden="true">
          <span class="xy-art-sun"></span>
          <span class="xy-art-island"></span>
          <span class="xy-art-spark xy-spark-one"></span>
          <span class="xy-art-spark xy-spark-two"></span>
          <span class="xy-art-tag">PLAY & DISCOVER</span>
        </div>
        <div class="xy-pillar-copy">
          <span class="xy-pillar-kicker">01 · Gaming</span>
          <h2>Find your next discovery.</h2>
          <p>Explore guides, tips, discoveries, and carefully sourced updates for games Xychen covers.</p>
          <span class="xy-pillar-link">Explore gaming <span aria-hidden="true">↗</span></span>
        </div>
      </a>

      <a
        class="xy-pillar-card xy-pillar-community"
        id="community"
        href="https://discord.com/invite/xychen-server-1417846380432719915"
        target="_blank"
        rel="noopener noreferrer"
      >
        <div class="xy-pillar-art xy-pillar-art-community" aria-hidden="true">
          <span class="xy-community-flower xy-flower-one"></span>
          <span class="xy-community-flower xy-flower-two"></span>
          <span class="xy-art-tag">MEET & CONNECT</span>
        </div>
        <div class="xy-pillar-copy">
          <span class="xy-pillar-kicker">02 · Community</span>
          <h2>Good things grow together.</h2>
          <p>Visit the Discord community to chat, connect, and keep up with the people around XYCHEN.</p>
          <span class="xy-pillar-link">Visit the community <span aria-hidden="true">↗</span></span>
        </div>
      </a>

      <a class="xy-pillar-card xy-pillar-creator" href="/about/">
        <div class="xy-pillar-art xy-pillar-art-creator" aria-hidden="true">
          <span class="xy-creator-window"></span>
          <span class="xy-creator-star">✳</span>
          <span class="xy-art-tag">MAKE & SHARE</span>
        </div>
        <div class="xy-pillar-copy">
          <span class="xy-pillar-kicker">03 · Creator</span>
          <h2>A little about the creator.</h2>
          <p>Get to know Xychen, explore projects, and find the official social channels.</p>
          <span class="xy-pillar-link">Meet Xychen <span aria-hidden="true">↗</span></span>
        </div>
      </a>
    </div>
  </section>

  <section class="xy-latest section-block" aria-labelledby="xy-latest-title">
    <div class="container">
      <div class="xy-section-heading">
        <div>
          <p class="xy-section-eyebrow">Fresh from the library</p>
          <h2 id="xy-latest-title">Latest discoveries</h2>
        </div>
        <a class="xy-text-link" href="/content/">Browse all gaming content <span aria-hidden="true">↗</span></a>
      </div>

      {articles.length > 0 ? (
        <div class="xy-latest-grid">
          {articles.map((article) => (
            <article class="xy-article-card">
              <div class="xy-article-topline">
                <span>{categoryLabels[article.data.category] ?? "Article"}</span>
                <time datetime={article.data.pubDate.toISOString()}>{dateFormatter.format(article.data.pubDate)}</time>
              </div>
              <p class="xy-article-game">{article.data.game ?? "Gaming"}</p>
              <h3><a href={`/content/${article.id}/`}>{article.data.title}</a></h3>
              <p class="xy-article-description">{article.data.description}</p>
              <a class="xy-article-read" href={`/content/${article.id}/`}>Read article <span aria-hidden="true">↗</span></a>
            </article>
          ))}
        </div>
      ) : (
        <div class="xy-empty-state">
          <h3>New discoveries are on the way.</h3>
          <p>Published guides and gaming updates will appear here when they are ready.</p>
        </div>
      )}
    </div>
  </section>

  <section class="xy-creator-note section-block" aria-labelledby="xy-creator-note-title">
    <div class="container xy-creator-note-inner">
      <span class="xy-note-flower" aria-hidden="true">✳</span>
      <div>
        <p class="xy-section-eyebrow">A little more about XYCHEN</p>
        <h2 id="xy-creator-note-title">Built around curiosity and community.</h2>
        <p>Start with a game, stay for the discoveries, and find the people and projects that make this place what it is.</p>
      </div>
      <a class="xy-button xy-button-secondary" href="/about/">About XYCHEN <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</BaseLayout>
