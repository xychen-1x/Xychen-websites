---
import BaseLayout from "@layouts/BaseLayout.astro";
import { assets } from "@config/assets";
---

<BaseLayout
  title="Xychen"
  description="A creator-led website for Roblox content, practical guides, discoveries, and game updates."
>
  <section class="hero-section">
    <div class="container hero-layout">
      <div class="hero-content">
        <p class="eyebrow"><span class="status-dot"></span> The website of Xychen</p>
        <h1>Games, guides,<br /><span>and discoveries.</span></h1>
        <p class="hero-description">
          A place for game content, practical information, and things worth exploring — starting with Roblox and growing beyond it.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="/content/">Explore content <span aria-hidden="true">↗</span></a>
          <a class="button button-secondary" href="/about/">About Xychen</a>
        </div>
      </div>

      <aside class="hero-side-panel" aria-label="What you can explore">
        <img
          class="hero-artwork"
          src={assets.heroArtwork}
          alt=""
          width="720"
          height="560"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        <p class="panel-kicker">Inside Xychen</p>
        <h2>Find a useful place to start.</h2>
        <ul class="hero-topic-list">
          <li>
            <a class="hero-topic-link" href="/content/category/guides/">
              <span class="topic-index">01</span>
              <span><strong>Guides & tutorials</strong><small>Understand game features step by step.</small></span>
              <span class="topic-arrow" aria-hidden="true">↗</span>
            </a>
          </li>
          <li>
            <a class="hero-topic-link" href="/content/tips-and-discoveries/">
              <span class="topic-index">02</span>
              <span><strong>Tips & discoveries</strong><small>Explore details worth knowing.</small></span>
              <span class="topic-arrow" aria-hidden="true">↗</span>
            </a>
          </li>
          <li>
            <a class="hero-topic-link" href="/content/category/updates/">
              <span class="topic-index">03</span>
              <span><strong>Games & updates</strong><small>Keep up with selected game coverage.</small></span>
              <span class="topic-arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        </ul>
        <p class="panel-footnote">Clear sources. Dates where they matter. Unconfirmed claims labelled.</p>
      </aside>
    </div>
  </section>

  <section class="section-block">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Browse the website</p>
          <h2>Find what you need.</h2>
        </div>
        <p class="section-intro">A structured home for game information, practical help, and things worth exploring.</p>
      </div>

      <div class="feature-grid">
        <a class="feature-card" href="/content/">
          <span class="card-index">01 / CONTENT</span>
          <h3>Guides & discoveries</h3>
          <p>How-tos, tips, explainers, and researched game information.</p>
          <span class="card-arrow" aria-hidden="true">↗</span>
        </a>
        <a class="feature-card feature-card--garden" href="/grow-a-garden/">
          <span class="card-index">02 / ROBLOX</span>
          <h3>Grow a Garden</h3>
          <p>A dedicated place for game details, guides, and update coverage.</p>
          <span class="card-arrow" aria-hidden="true">↗</span>
        </a>
        <a class="feature-card" href="/content/">
          <span class="card-index">03 / MORE GAMES</span>
          <h3>Other games</h3>
          <p>Explore the content section for coverage beyond Grow a Garden.</p>
          <span class="card-arrow" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section-block content-latest-section" id="community">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Community</p>
          <h2>Join the conversation.</h2>
        </div>
        <p class="section-intro">Xychen Community is the Discord space connected to this website. The website itself remains focused on Xychen's content and projects.</p>
      </div>
      <a
        class="button button-primary"
        href="https://discord.com/invite/xychen-server-1417846380432719915"
        target="_blank"
        rel="noopener noreferrer"
      >
        Visit Xychen Community <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>

  <section class="statement-section">
    <div class="container statement-inner">
      <p class="eyebrow">The approach</p>
      <h2>Useful information.<br />Clear sources. No guesswork.</h2>
      <p>Published information should be understandable, dated when relevant, and linked to its source. Rumors and leaks will be clearly marked as unconfirmed.</p>
    </div>
  </section>
</BaseLayout>
