---
import { siteConfig } from "../config/site";
import { assets } from "../config/assets";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-main">
    <div class="footer-brand">
      <a class="wordmark footer-wordmark" href="/" aria-label="Xychen home">
        <img class="wordmark-mark" src={assets.brandMark} alt="" width="30" height="30" />
        <span class="wordmark-name">{siteConfig.name}</span>
      </a>
      <p>Guides, discoveries, and useful details from Roblox and other games.</p>
    </div>

    <nav class="footer-column" aria-label="Footer navigation">
      <h2 class="footer-heading">Explore</h2>
      <ul class="footer-link-list">
        {siteConfig.navigation.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="footer-column">
      <h2 class="footer-heading">Find Xychen</h2>
      <ul class="footer-link-list footer-social-list">
        {siteConfig.socials.map((social) => (
          <li>
            <a href={social.href} target="_blank" rel="noopener noreferrer">
              {social.label}<span aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="footer-column footer-community">
      <h2 class="footer-heading">Community</h2>
      <p>Xychen Community is the Discord space connected to this website.</p>
      <a
        class="footer-community-link"
        href="https://discord.com/invite/xychen-server-1417846380432719915"
        target="_blank"
        rel="noopener noreferrer"
      >
        Visit Discord <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>

  <div class="container footer-bottom">
    <small>© {year} Xychen. All rights reserved.</small>
    <a href="#main-content">Back to top <span aria-hidden="true">↑</span></a>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    background: var(--surface);
  }

  .footer-main {
    display: grid;
    grid-template-columns: minmax(220px, 1.25fr) repeat(3, minmax(0, 0.8fr));
    gap: clamp(28px, 5vw, 64px);
    padding-block: 54px 46px;
  }

  .footer-brand p,
  .footer-community p {
    max-width: 260px;
    margin: 16px 0 0;
    color: var(--muted);
    font-size: 0.86rem;
    line-height: 1.7;
  }

  .footer-heading {
    margin: 3px 0 16px;
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .footer-link-list {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-link-list a,
  .footer-community-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--text);
    font-size: 0.86rem;
    transition: color 150ms ease;
  }

  .footer-link-list a:hover,
  .footer-community-link:hover,
  .footer-bottom a:hover {
    color: var(--accent);
  }

  .footer-social-list {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 18px;
  }

  .footer-social-list a span,
  .footer-community-link span {
    color: var(--accent);
    font-size: 0.78rem;
  }

  .footer-community-link {
    margin-top: 15px;
    color: var(--accent);
    font-weight: 700;
  }

  .footer-bottom {
    min-height: 62px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    border-top: 1px solid var(--line);
  }

  .footer-bottom small,
  .footer-bottom a {
    color: var(--muted);
    font-size: 0.76rem;
  }

  .footer-bottom a {
    transition: color 150ms ease;
  }

  @media (max-width: 900px) {
    .footer-main {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 520px) {
    .footer-main {
      grid-template-columns: 1fr;
      gap: 30px;
      padding-block: 42px 36px;
    }

    .footer-brand {
      grid-column: auto;
    }

    .footer-bottom {
      align-items: flex-start;
      flex-direction: column;
      justify-content: center;
      gap: 8px;
      padding-block: 16px;
    }
  }
</style>
