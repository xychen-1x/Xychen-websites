---
import { siteConfig } from "../config/site";
import { assets } from "../config/assets";

const year = new Date().getFullYear();

const socialIcons = {
  TikTok: '<path d="M15.8 3c.4 2.1 1.6 3.4 3.7 3.6v3.1a8.2 8.2 0 0 1-3.7-1.1v6.7a5.7 5.7 0 1 1-5.7-5.7c.4 0 .8 0 1.2.1v3.2a2.7 2.7 0 1 0 1.5 2.4V3h3Z"/>',
  YouTube: '<path d="M23 7.2a3 3 0 0 0-2.1-2.1C19 4.6 12 4.6 12 4.6s-7 0-8.9.5A3 3 0 0 0 1 7.2 31 31 0 0 0 .5 12a31 31 0 0 0 .5 4.8 3 3 0 0 0 2.1 2.1c1.9.5 8.9.5 8.9.5s7 0 8.9-.5a3 3 0 0 0 2.1-2.1 31 31 0 0 0 .5-4.8 31 31 0 0 0-.5-4.8ZM9.7 15.5v-7l6.1 3.5-6.1 3.5Z"/>',
  Instagram: '<rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2.2"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2.2"/><circle cx="18" cy="6.5" r="1.2"/>',
  Facebook: '<path d="M13.4 21v-8h2.7l.4-3.1h-3.1v-2c0-.9.3-1.5 1.6-1.5h1.7V3.6c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3v2.1H7.2V13H10v8h3.4Z"/>',
  X: '<path d="M18.9 2H22l-6.8 7.8L23.2 22h-6.3L12 14.9 5.8 22H2.7l7.3-8.4L2.3 2h6.5l4.5 6.7L18.9 2Zm-1.1 18h1.7L7.8 3.9H6L17.8 20Z"/>',
  GitHub: '<path d="M12 .8a11.2 11.2 0 0 0-3.5 21.8c.6.1.8-.3.8-.6v-2.1c-3.1.7-3.8-1.3-3.8-1.3-.5-1.2-1.2-1.5-1.2-1.5-1-.7.1-.7.1-.7 1.1.1 1.7 1.1 1.7 1.1 1 .1.7 2.1 3.7 1.5.1-.7.4-1.2.7-1.5-2.5-.3-5.1-1.3-5.1-5.5 0-1.2.4-2.1 1.1-2.9-.1-.3-.5-1.4.1-2.9 0 0 .9-.3 3 1.1a10.4 10.4 0 0 1 5.5 0c2.1-1.4 3-1.1 3-1.1.6 1.5.2 2.6.1 2.9.7.8 1.1 1.7 1.1 2.9 0 4.2-2.6 5.2-5.1 5.5.4.3.8 1 .8 2v3c0 .3.2.7.8.6A11.2 11.2 0 0 0 12 .8Z"/>',
  Discord: '<path d="M19.7 5.2A18 18 0 0 0 15.3 4l-.6 1.2a16.5 16.5 0 0 0-5.4 0L8.7 4a18 18 0 0 0-4.4 1.2C1.5 9.3.7 13.3 1.1 17.3a18 18 0 0 0 5.4 2.7l1.2-2a11 11 0 0 1-1.9-.9l.5-.4a12.8 12.8 0 0 0 11.4 0l.5.4a11 11 0 0 1-1.9.9l1.2 2a18 18 0 0 0 5.4-2.7c.5-4.6-.8-8.5-3.2-12.1ZM8.7 14.5c-1 0-1.8-.9-1.8-2s.8-2 1.8-2 1.8.9 1.8 2-.8 2-1.8 2Zm6.6 0c-1 0-1.8-.9-1.8-2s.8-2 1.8-2 1.8.9 1.8 2-.8 2-1.8 2Z"/>',
} as const;
---

<footer class="site-footer">
  <div class="container footer-main">
    <div class="footer-brand">
      <a class="wordmark footer-wordmark" href="/" aria-label="Xychen home">
        <img class="wordmark-mark" src={assets.brandMark} alt="" width="30" height="30" />
        <span class="wordmark-name">{siteConfig.name}</span>
      </a>
      <p>Guides, discoveries, and useful details from Roblox and other games.</p>
    </div>

    <nav class="footer-column" aria-label="Footer navigation">
      <h2 class="footer-heading">Explore</h2>
      <ul class="footer-link-list">
        {siteConfig.navigation.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <section class="footer-column footer-find" aria-labelledby="footer-find-title">
      <h2 class="footer-heading" id="footer-find-title">Find Xychen</h2>
      <ul class="footer-social-grid">
        {siteConfig.socials.map((social) => (
          <li>
            <a class="footer-social-link" href={social.href} target="_blank" rel="noopener noreferrer" aria-label={`Xychen on ${social.label}`}>
              <span class="footer-social-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false" set:html={socialIcons[social.label as keyof typeof socialIcons]} />
              </span>
              <span class="footer-social-name">{social.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="footer-column footer-community" aria-labelledby="footer-community-title">
      <h2 class="footer-heading" id="footer-community-title">Community</h2>
      <a
        class="footer-social-link footer-discord-link"
        href="https://discord.com/invite/xychen-server-1417846380432719915"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Join Xychen Community on Discord"
      >
        <span class="footer-social-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" focusable="false" set:html={socialIcons.Discord} />
        </span>
        <span class="footer-social-name">Discord</span>
      </a>
    </section>
  </div>

  <div class="container footer-bottom">
    <small>© {year} Xychen. All rights reserved.</small>
    <a href="#main-content">Back to top <span aria-hidden="true">↑</span></a>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    background: var(--surface);
  }

  .footer-main {
    display: grid;
    grid-template-columns: minmax(180px, 1fr) minmax(130px, 0.7fr) minmax(250px, 1.2fr) minmax(110px, 0.55fr);
    align-items: start;
    gap: clamp(24px, 3.5vw, 48px);
    padding-block: 58px 64px;
  }

  .footer-brand p {
    max-width: 245px;
    margin: 16px 0 0;
    color: var(--muted);
    font-size: 0.86rem;
    line-height: 1.7;
  }

  .footer-heading {
    margin: 3px 0 22px;
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .footer-link-list {
    display: grid;
    gap: 13px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-link-list a {
    color: var(--text);
    font-size: 0.86rem;
    transition: color 150ms ease;
  }

  .footer-link-list a:hover,
  .footer-bottom a:hover {
    color: var(--accent);
  }

  .footer-social-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(66px, 1fr));
    gap: 26px 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-social-link {
    width: 100%;
    min-height: 86px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 12px;
    padding: 8px 5px 10px;
    border-radius: 10px;
    color: var(--text);
    text-align: center;
    transition: color 150ms ease, background-color 150ms ease, transform 150ms ease;
  }

  .footer-social-link:hover {
    color: var(--accent);
    background: var(--raised);
    transform: translateY(-2px);
  }

  .footer-social-icon {
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    color: currentColor;
  }

  .footer-social-icon svg {
    display: block;
    width: 25px;
    height: 25px;
    fill: currentColor;
  }

  .footer-social-name {
    font-size: 0.78rem;
    line-height: 1.3;
  }

  .footer-discord-link {
    max-width: 90px;
  }

  .footer-bottom {
    min-height: 62px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    border-top: 1px solid var(--line);
  }

  .footer-bottom small,
  .footer-bottom a {
    color: var(--muted);
    font-size: 0.76rem;
  }

  .footer-bottom a {
    transition: color 150ms ease;
  }

  @media (max-width: 1050px) {
    .footer-main {
      grid-template-columns: minmax(170px, 1fr) minmax(130px, 0.7fr) minmax(230px, 1.2fr);
      row-gap: 42px;
    }

    .footer-community {
      grid-column: 3;
    }
  }

  @media (max-width: 760px) {
    .footer-main {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 38px 28px;
      padding-block: 48px 52px;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }

    .footer-find {
      grid-column: 1 / -1;
    }

    .footer-social-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      max-width: 420px;
      gap: 22px 16px;
    }

    .footer-community {
      grid-column: auto;
    }
  }

  @media (max-width: 480px) {
    .footer-main {
      grid-template-columns: 1fr 1fr;
      gap: 34px 20px;
    }

    .footer-brand,
    .footer-find {
      grid-column: 1 / -1;
    }

    .footer-social-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      max-width: none;
      gap: 18px 10px;
    }

    .footer-community {
      grid-column: 1 / -1;
    }

    .footer-discord-link {
      max-width: 90px;
    }

    .footer-bottom {
      align-items: flex-start;
      flex-direction: column;
      justify-content: center;
      gap: 8px;
      padding-block: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-social-link {
      transition: none;
    }

    .footer-social-link:hover {
      transform: none;
    }
  }
</style>
