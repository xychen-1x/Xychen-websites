---
import { siteConfig } from "../config/site";
const currentPath = Astro.url.pathname;
---
<header class="site-header">
  <div class="container header-inner">
    <a class="header-home-link" href="/" aria-label="XYCHEN home">XYCHEN</a>
    <nav class="desktop-nav" aria-label="Main navigation">
      {siteConfig.navigation.map((item) => (
        <a href={item.href} aria-current={currentPath === item.href ? "page" : undefined}>{item.label}</a>
      ))}
    </nav>
    <div class="header-actions">
      <button class="icon-control search-control" type="button" data-search-open aria-label="Open site search" title="Search">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.6"></circle><path d="m16 16 4.2 4.2"></path></svg>
      </button>
      <button class="icon-control theme-toggle" type="button" data-theme-toggle aria-pressed="false" title="Change theme">
        <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3.7"></circle><path d="M12 2.2v2.1M12 19.7v2.1M4.1 4.1l1.5 1.5m12.8 12.8 1.5 1.5M2.2 12h2.1m15.4 0h2.1M4.1 19.9l1.5-1.5M18.4 5.6l1.5-1.5"></path></svg>
        <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M19.4 15.2A8.2 8.2 0 0 1 8.8 4.6 8.5 8.5 0 1 0 19.4 15.2Z"></path></svg>
        <span class="sr-only" data-theme-label>Switch to dark theme</span>
      </button>
      <details class="mobile-menu">
        <summary aria-label="Open navigation menu"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg></summary>
        <nav aria-label="Mobile navigation">
          {siteConfig.navigation.map((item) => <a href={item.href} aria-current={currentPath === item.href ? "page" : undefined}>{item.label}</a>)}
          <button type="button" data-search-open>Search</button>
        </nav>
      </details>
    </div>
  </div>
</header>
<dialog class="site-search-dialog" data-search-dialog aria-labelledby="site-search-title">
  <form class="site-search-form" action="/content/" method="get">
    <div class="site-search-heading">
      <h2 id="site-search-title">Search XYCHEN</h2>
      <button class="site-search-close" type="button" data-search-close aria-label="Close search">×</button>
    </div>
    <label for="site-search-input">Search published gaming content</label>
    <div class="site-search-field">
      <input id="site-search-input" name="q" type="search" placeholder="Try a game, seed, guide, or update…" autocomplete="off">
      <button type="submit">Search</button>
    </div>
    <p>Results match article titles, summaries, games, and tags.</p>
  </form>
</dialog>
<script>
  const dialog = document.querySelector<HTMLDialogElement>("[data-search-dialog]");
  const searchField = document.querySelector<HTMLInputElement>("#site-search-input");
  let activeSearchTrigger: HTMLElement | null = null;

  document.querySelectorAll<HTMLButtonElement>("[data-search-open]").forEach((button) => {
    button.addEventListener("click", () => {
      if (!dialog) return;
      const mobileMenu = button.closest("details");
      activeSearchTrigger = mobileMenu?.querySelector<HTMLElement>("summary") ?? button;
      mobileMenu?.removeAttribute("open");
      dialog.showModal();
      searchField?.focus();
    });
  });

  document.querySelector<HTMLButtonElement>("[data-search-close]")?.addEventListener("click", () => dialog?.close());
  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog) dialog.close();
  });
  dialog?.addEventListener("close", () => activeSearchTrigger?.focus());
</script>
