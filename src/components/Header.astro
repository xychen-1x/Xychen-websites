---
import { siteConfig } from "../config/site";

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="container header-inner">
    <nav class="desktop-nav" aria-label="Main navigation">
      {siteConfig.navigation.map((item) => (
        <a href={item.href} aria-current={currentPath === item.href ? "page" : undefined}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <a class="icon-control search-control" href="/content/#content-search" aria-label="Search gaming content" title="Search">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <circle cx="10.8" cy="10.8" r="6.6"></circle>
          <path d="m16 16 4.2 4.2"></path>
        </svg>
      </a>

      <button class="icon-control theme-toggle" type="button" data-theme-toggle
        aria-label="Switch to dark theme" aria-pressed="false" title="Change theme">
        <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <circle cx="12" cy="12" r="3.7"></circle>
          <path d="M12 2.2v2.1M12 19.7v2.1M4.1 4.1l1.5 1.5m12.8 12.8 1.5 1.5M2.2 12h2.1m15.4 0h2.1M4.1 19.9l1.5-1.5M18.4 5.6l1.5-1.5"></path>
        </svg>
        <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M19.4 15.2A8.2 8.2 0 0 1 8.8 4.6 8.5 8.5 0 1 0 19.4 15.2Z"></path>
        </svg>
        <span class="sr-only" data-theme-label>Switch to dark theme</span>
      </button>

      <details class="mobile-menu">
        <summary aria-label="Open navigation menu">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
        </summary>
        <nav aria-label="Mobile navigation">
          {siteConfig.navigation.map((item) => (
            <a href={item.href} aria-current={currentPath === item.href ? "page" : undefined}>
              {item.label}
            </a>
          ))}
          <a href="/content/#content-search">Search</a>
        </nav>
      </details>
    </div>
  </div>
</header>
