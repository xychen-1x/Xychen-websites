---
import type { CollectionEntry } from "astro:content";
import { getContentCategoryLabel } from "../config/content";
interface Props { article: CollectionEntry<"articles">; }
const { article } = Astro.props;
const categoryLabel = getContentCategoryLabel(article.data.category);
const verificationLabel = {
  verified: "Source checked",
  unconfirmed: "Unconfirmed",
  editorial: "Original",
}[article.data.verificationStatus];
const searchableText = [
  article.data.title,
  article.data.description,
  article.data.game ?? "",
  article.data.category,
  ...article.data.tags,
].join(" ");
---
<article
  class="content-card"
  data-category={article.data.category}
  data-search-text={searchableText}
>
  <a class="content-card-link" href={`/content/${article.id}/`}>
    <div class="content-card-visual" aria-hidden="true"><span>{categoryLabel}</span></div>
    <div class="content-card-copy">
      <div class="content-card-meta">
        <span class="content-card-category">{categoryLabel}</span>
        {(article.data.category === "updates" || article.data.category === "announcements" || article.data.verificationStatus === "unconfirmed") && (
          <time datetime={article.data.pubDate.toISOString()}>{new Intl.DateTimeFormat("en-PH", { dateStyle: "medium" }).format(article.data.pubDate)}</time>
        )}
      </div>
      <h2>{article.data.title}</h2>
      <p>{article.data.description}</p>
      <div class="content-card-footer">
        <span class:list={["content-verification", `content-verification--${article.data.verificationStatus}`]}>{verificationLabel}</span>
        <span class="content-card-read">Read article <span aria-hidden="true">↗</span></span>
      </div>
    </div>
  </a>
</article>
