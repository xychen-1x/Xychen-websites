---
import type { CollectionEntry } from "astro:content";
import { getContentCategoryLabel } from "../config/content";

interface Props {
  article: CollectionEntry<"articles">;
}

const { article } = Astro.props;
const categoryLabel = getContentCategoryLabel(article.data.category);
const publishedDate = new Intl.DateTimeFormat("en-PH", {
  dateStyle: "medium",
}).format(article.data.pubDate);

const verificationLabel = {
  verified: "Source checked",
  unconfirmed: "Unconfirmed",
  editorial: "Original",
}[article.data.verificationStatus];
---

<article class="content-card">
  <a class="content-card-link" href={`/content/${article.id}/`}>
    <div class="content-card-meta">
      <span class="content-card-category">{categoryLabel}</span>
      <time datetime={article.data.pubDate.toISOString()}>{publishedDate}</time>
    </div>
    <h2>{article.data.title}</h2>
    <p>{article.data.description}</p>
    <div class="content-card-footer">
      <span
        class:list={[
          "content-verification",
          `content-verification--${article.data.verificationStatus}`,
        ]}
      >
        {verificationLabel}
      </span>
      <span class="content-card-read">Read article <span aria-hidden="true">↗</span></span>
    </div>
  </a>
</article>
